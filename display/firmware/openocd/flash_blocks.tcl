# Raw flash writer for the FMD FT32F030 display MCU.
#
# The caller must source a plan file first (generated by tools/make_plan.py):
#   set PLAN { {0x08003000 {w0 w1 ... w511}} {0x08005000 {...}} ... }
# Each entry is one 2 KiB block (512 x 32-bit words, final contents).
#
# The sequence copies the display firmware's own flash HAL (0x08000420-0x08000590):
#   ACR bit4 cleared during the operation, SR flags cleared with 0x35,
#   erase: CR=PER, AR=page, CR|=STRT, wait BSY, CR&=~PER
#   program: CR|=PG, one 32-bit store, wait BSY, CR&=~PG (one word at a time)
# The datasheet gives a 512 B page size. 2 KiB blocks are erased as four
# 512 B pages, so a 512 B, 1 KiB or 2 KiB page size all stay inside the block.
#
# Never touches block 0 (vector table) or the option bytes.

set FLASH_ACR  0x40022000
set FLASH_KEYR 0x40022004
set FLASH_SR   0x4002200C
set FLASH_CR   0x40022010
set FLASH_AR   0x40022014
set IWDG_KR    0x40003000
set BLOCK      0x800
set PAGE       0x200
set WORDS      [expr {0x800 / 4}]

proc rd32 {a} { return [lindex [read_memory $a 32 1] 0] }
proc wr32 {a v} { write_memory $a 32 $v }

proc kick {} {
	# Reload the IWDG in case the firmware started it before we halted.
	# Harmless when the watchdog is not running.
	catch { wr32 $::IWDG_KR 0xAAAA }
	set st [[target current] curstate]
	if { $st ne "halted" } { error "target is no longer halted (state: $st) - watchdog/reset?" }
}

proc wait_bsy {} {
	for { set i 0 } { $i < 2000 } { incr i } {
		set sr [rd32 $::FLASH_SR]
		if { ($sr & 0x01) == 0 } {
			if { $sr & 0x14 } { error [format "flash error SR=0x%08X (PGERR/WRPRTERR)" $sr] }
			wr32 $::FLASH_SR 0x20 ;# clear EOP
			return
		}
	}
	error "timeout waiting for BSY"
}

proc fail {msg} {
	catch { wr32 $::FLASH_CR 0x80 }
	catch { wr32 $::FLASH_ACR $::acr_saved }
	echo "FLASH FAILED: $msg"
	echo "Flash is in an unknown state. Do NOT power off. Re-run tools/flash.sh with the backup."
	shutdown error
}

if { ![info exists PLAN] } { echo "no PLAN loaded"; shutdown error }

# Sanity check every block before touching anything.
foreach entry $PLAN {
	set base [lindex $entry 0]
	set data [lindex $entry 1]
	if { $base < 0x08000800 || $base > 0x0800F800 || ($base % $BLOCK) != 0 } {
		echo [format "refusing block 0x%08X (out of range / unaligned / vector table)" $base]; shutdown error
	}
	if { [llength $data] != $WORDS } { echo "block $base has [llength $data] words"; shutdown error }
}

set acr_saved [rd32 $FLASH_ACR]
kick

# Unlock
wr32 $FLASH_KEYR 0x45670123
wr32 $FLASH_KEYR 0xCDEF89AB
if { [rd32 $FLASH_CR] & 0x80 } { echo "unlock failed, nothing written"; shutdown error }
wr32 $FLASH_ACR [expr {$acr_saved & ~0x10}]
echo "unlocked"

foreach entry $PLAN {
	set base [lindex $entry 0]
	set data [lindex $entry 1]
	echo [format "block 0x%08X: erase" $base]
	if { [catch {
		for { set p 0 } { $p < $BLOCK } { incr p $PAGE } {
			kick
			wr32 $FLASH_SR 0x35
			wr32 $FLASH_CR 0x02
			wr32 $FLASH_AR [expr {$base + $p}]
			wr32 $FLASH_CR 0x42
			wait_bsy
			wr32 $FLASH_CR 0x00
		}
	} err] } { fail $err }

	set rb [read_memory $base 32 $WORDS]
	foreach w $rb { if { $w != 0xFFFFFFFF } { fail [format "block 0x%08X not blank after erase" $base] } }

	echo [format "block 0x%08X: program" $base]
	if { [catch {
		set i 0
		foreach w $data {
			if { $w != 0xFFFFFFFF } {
				if { ($i % 64) == 0 } { kick }
				wr32 $FLASH_CR 0x01
				wr32 [expr {$base + $i * 4}] $w
				wait_bsy
				wr32 $FLASH_CR 0x00
			}
			incr i
		}
	} err] } { fail $err }

	set rb [read_memory $base 32 $WORDS]
	for { set i 0 } { $i < $WORDS } { incr i } {
		if { [lindex $rb $i] != [lindex $data $i] } {
			fail [format "verify mismatch @0x%08X: got 0x%08X want 0x%08X" \
				[expr {$base + $i * 4}] [lindex $rb $i] [lindex $data $i]]
		}
	}
	echo [format "block 0x%08X: verify OK" $base]
}

wr32 $FLASH_CR 0x80
wr32 $FLASH_ACR $acr_saved
echo "FLASH OK - locked"
